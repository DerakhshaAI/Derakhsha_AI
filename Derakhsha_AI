<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>درخشا · معماری هوش مصنوعی مغز‌محور</title>
    <!-- Font Awesome (آیکون) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <!-- D3.js برای رسم درخت -->
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <style>
        /* ----- Reset & Base ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0b0e1a;
            color: #e8edf5;
            line-height: 1.7;
            padding: 2rem 1rem;
        }
        .container {
            max-width: 1300px;
            margin: 0 auto;
        }

        /* ----- Header ----- */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 3rem;
            border-bottom: 2px solid #2a3a5e;
            padding-bottom: 1.5rem;
        }
        .logo h1 {
            font-size: 2.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #70e0ff, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
        }
        .logo span {
            font-size: 1rem;
            color: #8899bb;
            display: block;
            -webkit-text-fill-color: #8899bb;
        }
        .badge {
            background: #1e2a47;
            padding: 0.6rem 1.4rem;
            border-radius: 50px;
            border: 1px solid #4a6a9a;
            font-size: 0.9rem;
            color: #b0caf5;
        }
        .badge i {
            margin-left: 0.5rem;
            color: #70e0ff;
        }

        /* ----- Sections ----- */
        section {
            margin-bottom: 4rem;
        }
        h2 {
            font-size: 2rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }
        h2 i {
            color: #70e0ff;
            font-size: 1.8rem;
        }

        /* ----- Cortex Cards (قشرها) ----- */
        .cortex-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 1.5rem;
        }
        .cortex-card {
            background: #141b2b;
            border-radius: 16px;
            padding: 1.5rem 1.2rem;
            border: 1px solid #2a3a5e;
            transition: all 0.25s;
            cursor: default;
        }
        .cortex-card:hover {
            transform: translateY(-6px);
            border-color: #70e0ff;
            box-shadow: 0 8px 25px rgba(112, 224, 255, 0.15);
        }
        .cortex-card .icon {
            font-size: 2rem;
            color: #a78bfa;
            margin-bottom: 0.7rem;
        }
        .cortex-card h3 {
            font-size: 1.2rem;
            margin-bottom: 0.4rem;
            color: #c8daf5;
        }
        .cortex-card p {
            font-size: 0.9rem;
            color: #99aac5;
        }
        .cortex-card .new-tag {
            background: #fbbf24;
            color: #0b0e1a;
            font-size: 0.6rem;
            padding: 0.2rem 0.6rem;
            border-radius: 30px;
            font-weight: 700;
            display: inline-block;
            margin-top: 0.5rem;
        }

        /* ----- درخت (Tree) ----- */
        .tree-wrapper {
            background: #101725;
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid #2a3a5e;
            position: relative;
        }
        #tree-container {
            width: 100%;
            height: 460px;
            background: transparent;
            overflow: visible;
        }
        .tree-controls {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1.2rem;
            align-items: center;
        }
        .tree-controls input {
            flex: 2;
            min-width: 200px;
            background: #1a2338;
            border: 1px solid #3a4a6e;
            padding: 0.7rem 1.2rem;
            border-radius: 40px;
            color: #e8edf5;
            font-size: 1rem;
            outline: none;
            transition: 0.2s;
        }
        .tree-controls input:focus {
            border-color: #70e0ff;
            box-shadow: 0 0 12px rgba(112, 224, 255, 0.2);
        }
        .tree-controls button {
            background: #2a4a7a;
            border: none;
            padding: 0.7rem 1.8rem;
            border-radius: 40px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1rem;
        }
        .tree-controls button:hover {
            background: #3a6aaa;
            transform: scale(1.02);
        }
        .tree-controls .btn-secondary {
            background: #2a2a4a;
        }
        .tree-controls .btn-secondary:hover {
            background: #3a3a6a;
        }
        #search-status {
            margin-top: 0.8rem;
            font-size: 0.95rem;
            color: #a0b8dd;
            background: #1a2338;
            padding: 0.5rem 1.2rem;
            border-radius: 30px;
            display: inline-block;
            border-left: 4px solid #70e0ff;
        }

        /* ----- فوتر ----- */
        footer {
            text-align: center;
            border-top: 1px solid #1e2a47;
            padding-top: 2rem;
            margin-top: 2rem;
            color: #667799;
            font-size: 0.9rem;
        }
        footer i {
            color: #a78bfa;
        }

        /* Responsive */
        @media (max-width: 700px) {
            header {
                flex-direction: column;
                align-items: start;
                gap: 1rem;
            }
            .logo h1 {
                font-size: 2.2rem;
            }
            #tree-container {
                height: 320px;
            }
        }
    </style>
</head>
<body>
<div class="container">

    <!-- HEADER -->
    <header>
        <div class="logo">
            <h1>درخشا</h1>
            <span>معماری هوش مصنوعی مغز‌محور · ماژولار &amp; جنگل دانش</span>
        </div>
        <div class="badge">
            <i class="fas fa-code-branch"></i> v0.6 · آزمایشی
        </div>
    </header>

    <!-- معرفی -->
    <section>
        <h2><i class="fas fa-brain"></i> قشرهای تخصصی</h2>
        <div class="cortex-grid">
            <div class="cortex-card">
                <div class="icon"><i class="fas fa-microchip"></i></div>
                <h3>قشر ورودی</h3>
                <p>پاکسازی و آماده‌سازی متن، تشخیص موجودیت‌ها</p>
            </div>
            <div class="cortex-card">
                <div class="icon"><i class="fas fa-tree"></i></div>
                <h3>درخت زبان</h3>
                <p>تبدیل جمله به ساختار درختی و بازسازی</p>
            </div>
            <div class="cortex-card">
                <div class="icon"><i class="fas fa-forest"></i></div>
                <h3>جنگل دانش</h3>
                <p>درخت‌های تخصصی (زیست، فیزیک، فناوری، ...)</p>
            </div>
            <div class="cortex-card">
                <div class="icon"><i class="fas fa-search-plus"></i></div>
                <h3>جستجوی هرمی</h3>
                <p>جزء → کل برای یافتن زمینه</p>
            </div>
            <div class="cortex-card">
                <div class="icon"><i class="fas fa-search-minus"></i></div>
                <h3>جستجوی درختی</h3>
                <p>کل → جزء برای رسیدن به جزئیات</p>
            </div>
            <div class="cortex-card">
                <div class="icon"><i class="fas fa-link"></i></div>
                <h3>ارتباط بین‌درختی</h3>
                <p>اتصال مفاهیم مرتبط میان حوزه‌ها</p>
            </div>
            <div class="cortex-card" style="border-color: #a78bfa;">
                <div class="icon"><i class="fas fa-clock"></i></div>
                <h3>قشر زمانی <span class="new-tag">جدید</span></h3>
                <p>ذخیره توالی علی و پیش‌بینی روندها</p>
            </div>
            <div class="cortex-card" style="border-color: #fbbf24;">
                <div class="icon"><i class="fas fa-random"></i></div>
                <h3>گره‌های احتمالاتی <span class="new-tag">جدید</span></h3>
                <p>جستجوی موازی با ضرایب اطمینان</p>
            </div>
            <div class="cortex-card" style="border-color: #34d399;">
                <div class="icon"><i class="fas fa-cut"></i></div>
                <h3>هرس پویا <span class="new-tag">جدید</span></h3>
                <p>فشرده‌سازی و پیوند موقت درختان</p>
            </div>
            <div class="cortex-card" style="border-color: #f472b6;">
                <div class="icon"><i class="fas fa-eye"></i></div>
                <h3>فراشناخت <span class="new-tag">جدید</span></h3>
                <p>ناظر بر پردازش و تغییر استراتژی</p>
            </div>
            <div class="cortex-card" style="border-color: #60a5fa;">
                <div class="icon"><i class="fas fa-project-diagram"></i></div>
                <h3>استدلال قیاسی <span class="new-tag">جدید</span></h3>
                <p>انتقال الگوی روابط بین حوزه‌ها</p>
            </div>
            <div class="cortex-card">
                <div class="icon"><i class="fas fa-robot"></i></div>
                <h3>یادگیری تجربی</h3>
                <p>تقویت/تضعیف مسیرها بر اساس نتایج</p>
            </div>
        </div>
    </section>

    <!-- درخت دانش + دموی جستجو -->
    <section>
        <h2><i class="fas fa-sitemap"></i> جنگل دانش · شبیه‌سازی تعاملی</h2>
        <div class="tree-wrapper">
            <div id="tree-container"></div>

            <div class="tree-controls">
                <input type="text" id="search-input" placeholder="مثلاً: «فتوسنتز» یا «قلب» را جستجو کن..." />
                <button id="search-btn"><i class="fas fa-search"></i> جستجوی هرمی</button>
                <button id="reset-btn" class="btn-secondary"><i class="fas fa-undo-alt"></i> بازنشانی</button>
            </div>
            <div id="search-status">
                <i class="fas fa-arrows-alt-h" style="margin-left:0.6rem;"></i>
                آماده · مسیر جستجو در درخت مشخص می‌شود
            </div>
        </div>
        <p style="margin-top:1rem; font-size:0.9rem; color:#8899bb;">
            <i class="fas fa-info-circle"></i>
            گره‌های آبی = مفهوم، گره‌های طلایی = مسیر یافت‌شده. جستجو از جزء به کل (هرمی) و کل به جزء (درختی) را تجربه کنید.
        </p>
    </section>

    <!-- توضیح قابلیت‌های جدید -->
    <section>
        <h2><i class="fas fa-rocket"></i> قابلیت‌های حدیدی (جدید)</h2>
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap:1.2rem; background:#101725; padding:1.5rem; border-radius:20px; border:1px solid #2a3a5e;">
            <div><span style="color:#fbbf24;">⏳</span> <strong>قشر زمانی</strong> – پیش‌بینی بر اساس توالی</div>
            <div><span style="color:#fbbf24;">🎲</span> <strong>گره‌های احتمالاتی</strong> – جستجوی موازی با اطمینان</div>
            <div><span style="color:#fbbf24;">✂️</span> <strong>هرس پویا</strong> – مدیریت حافظه فعال</div>
            <div><span style="color:#fbbf24;">🧠</span> <strong>فراشناخت</strong> – تغییر استراتژی خودکار</div>
            <div><span style="color:#fbbf24;">🔗</span> <strong>استدلال قیاسی</strong> – انتقال الگو بین حوزه‌ها</div>
            <div><span style="color:#fbbf24;">📊</span> <strong>معیارهای اندازه‌گیری</strong> – هزینه، سرعت، خلاقیت</div>
        </div>
    </section>

    <footer>
        <i class="fas fa-code"></i> معماری درخشا · طراحی شده برای GitHub Pages · <i class="fas fa-tree"></i> جنگل دانش پویا
    </footer>
</div>

<!-- ==================== اسکریپت ==================== -->
<script>
    (function() {
        // ----- داده‌های درخت (جنگل دانش نمونه) -----
        const treeData = {
            name: "جهان دانش",
            children: [
                {
                    name: "زیست‌شناسی",
                    children: [
                        { name: "سلول", children: [
                            { name: "هسته" },
                            { name: "میتوکندری" },
                            { name: "کلروپلاست" }
                        ]},
                        { name: "قلب", children: [
                            { name: "دهلیز" },
                            { name: "بطن" },
                            { name: "دریچه" }
                        ]},
                        { name: "فتوسنتز", children: [
                            { name: "کلروفیل" },
                            { name: "نور" },
                            { name: "دی‌اکسید کربن" }
                        ]}
                    ]
                },
                {
                    name: "فیزیک",
                    children: [
                        { name: "مکانیک", children: [
                            { name: "قانون نیوتن" },
                            { name: "کار و انرژی" }
                        ]},
                        { name: "نور", children: [
                            { name: "موج" },
                            { name: "ذره" }
                        ]}
                    ]
                },
                {
                    name: "فناوری",
                    children: [
                        { name: "هوش مصنوعی", children: [
                            { name: "یادگیری عمیق" },
                            { name: "درخت تصمیم" }
                        ]},
                        { name: "شبکه", children: [
                            { name: "اینترنت" },
                            { name: "بلوک‌چین" }
                        ]}
                    ]
                }
            ]
        };

        // برای جستجو: لیست تمام نام‌ها (برای تطابق)
        let allNames = [];
        function collectNames(node) {
            allNames.push(node.name);
            if (node.children) {
                node.children.forEach(child => collectNames(child));
            }
        }
        collectNames(treeData);

        // ---------- رسم درخت با D3 ----------
        const width = document.getElementById('tree-container').clientWidth || 900;
        const height = 420;
        const margin = { top: 30, right: 80, bottom: 30, left: 80 };

        let svg, root, linkGroup, nodeGroup, labelGroup;
        let currentHighlight = null; // نام گره برجسته

        function renderTree(data, highlightName = null) {
            // حذف محتوای قبلی
            const container = document.getElementById('tree-container');
            container.innerHTML = '';

            svg = d3.select(container)
                .append('svg')
                .attr('width', '100%')
                .attr('height', height)
                .attr('viewBox', `0 0 ${width} ${height}`)
                .style('background', 'transparent');

            const g = svg.append('g')
                .attr('transform', `translate(${margin.left}, ${margin.top})`);

            const rootNode = d3.hierarchy(data);
            const treeLayout = d3.tree()
                .size([width - margin.left - margin.right, height - margin.top - margin.bottom]);
            root = treeLayout(rootNode);

            // ---------- Links ----------
            linkGroup = g.append('g').attr('class', 'links');
            const links = linkGroup.selectAll('path')
                .data(root.links())
                .enter()
                .append('path')
                .attr('d', d3.linkHorizontal()
                    .x(d => d.y)
                    .y(d => d.x)
                )
                .attr('fill', 'none')
                .attr('stroke', '#3a4a6e')
                .attr('stroke-width', 1.5)
                .attr('opacity', 0.7);

            // ---------- Nodes ----------
            nodeGroup = g.append('g').attr('class', 'nodes');
            const nodes = nodeGroup.selectAll('circle')
                .data(root.descendants())
                .enter()
                .append('circle')
                .attr('cx', d => d.y)
                .attr('cy', d => d.x)
                .attr('r', 8)
                .attr('fill', d => {
                    if (highlightName && d.data.name === highlightName) return '#fbbf24';
                    if (highlightName) {
                        // برجسته کردن مسیر (پدرها و فرزندان)
                        let isPath = false;
                        let node = d;
                        while (node) {
                            if (node.data.name === highlightName) { isPath = true; break; }
                            node = node.parent;
                        }
                        if (isPath) return '#fbbf24';
                        // چک کردن فرزندان
                        const descendants = d.descendants ? d.descendants() : [];
                        for (let child of descendants) {
                            if (child.data.name === highlightName) { isPath = true; break; }
                        }
                        if (isPath) return '#fbbf24';
                        return '#4a7aaa';
                    }
                    return '#4a7aaa';
                })
                .attr('stroke', '#70e0ff')
                .attr('stroke-width', 1.5)
                .style('cursor', 'pointer')
                .on('click', function(event, d) {
                    const name = d.data.name;
                    document.getElementById('search-input').value = name;
                    performSearch(name);
                });

            // ---------- Labels ----------
            labelGroup = g.append('g').attr('class', 'labels');
            const labels = labelGroup.selectAll('text')
                .data(root.descendants())
                .enter()
                .append('text')
                .attr('x', d => d.y)
                .attr('y', d => d.x - 14)
                .attr('text-anchor', 'middle')
                .attr('font-size', '11px')
                .attr('fill', '#c8daf5')
                .style('font-family', 'Segoe UI, sans-serif')
                .style('pointer-events', 'none')
                .text(d => d.data.name);

            // ذخیره ارجاع برای بروزرسانی
            currentHighlight = highlightName;
        }

        // ---------- تابع جستجو ----------
        function performSearch(query) {
            if (!query.trim()) {
                document.getElementById('search-status').innerHTML = '<i class="fas fa-info-circle"></i> لطفاً یک مفهوم وارد کنید.';
                renderTree(treeData);
                return;
            }

            const trimmed = query.trim();
            // پیدا کردن گره با نام مشابه (حساس به حروف کوچک/بزرگ)
            let found = false;
            let foundName = null;

            function findNode(node) {
                if (node.name.toLowerCase() === trimmed.toLowerCase()) {
                    foundName = node.name;
                    found = true;
                    return true;
                }
                if (node.children) {
                    for (let child of node.children) {
                        if (findNode(child)) return true;
                    }
                }
                return false;
            }
            findNode(treeData);

            if (found) {
                document.getElementById('search-status').innerHTML = `
                    <i class="fas fa-check-circle" style="color:#34d399;"></i>
                    یافت شد: «<strong style="color:#fbbf24;">${foundName}</strong>» · مسیر هرمی (جزء→کل) و درختی (کل→جزء) نمایش داده شد.
                `;
                renderTree(treeData, foundName);
                // اضافه کردن انیمیشن ساده (تغییر رنگ)
            } else {
                document.getElementById('search-status').innerHTML = `
                    <i class="fas fa-exclamation-triangle" style="color:#f87171;"></i>
                    «${trimmed}» در جنگل دانش یافت نشد. گره‌های موجود: ${allNames.slice(0, 10).join('، ')} ...
                `;
                renderTree(treeData);
            }
        }

        // ---------- رویدادها ----------
        document.getElementById('search-btn').addEventListener('click', function() {
            const input = document.getElementById('search-input');
            performSearch(input.value);
        });

        document.getElementById('search-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('search-btn').click();
            }
        });

        document.getElementById('reset-btn').addEventListener('click', function() {
            document.getElementById('search-input').value = '';
            document.getElementById('search-status').innerHTML = '<i class="fas fa-arrows-alt-h"></i> آماده · مسیر جستجو در درخت مشخص می‌شود';
            renderTree(treeData);
        });

        // ---------- Render اولیه ----------
        renderTree(treeData);

        // تنظیم مجدد در صورت تغییر سایز (اختیاری)
        window.addEventListener('resize', function() {
            // برای سادگی، فقط بازرندر نمی‌کنیم؛ اما می‌توان با گرفتن عرض جدید دوباره رسم کرد.
            // برای دمو، کافی است.
        });

    })();
</script>

</body>
</html>
